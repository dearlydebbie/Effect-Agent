# Server-only AI provider keys. Never use a public environment prefix.
EFFECT_LAB_MODE=production
ENABLE_DEMO_DATA=false
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-terra
VISION_QA_ENABLED=false
VISION_QA_MAX_ITERATIONS=3
ANTHROPIC_API_KEY=

# Future local or hosted database connection.
DATABASE_URL=

# Server-only local Lens Studio MCP connection. Run `npm run lens:sync` to populate .env.local.
LENS_STUDIO_MCP_URL=
LENS_STUDIO_MCP_AUTHORIZATION=
LENS_STUDIO_MCP_CONNECTION_SOURCE=
LENS_STUDIO_MCP_LAST_VERIFIED=
LENS_STUDIO_MCP_PROJECT_FINGERPRINT=
LENS_STUDIO_VERSION=

# Optional development override. Use "mock" only for interface development.
EFFECT_LAB_VISION_PROVIDER=

# Optional identity check used by npm run lens:sync.
LENS_STUDIO_EXPECTED_PROJECT_NAME=
LENS_STUDIO_EXPECTED_PROJECT_PATH=
